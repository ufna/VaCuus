#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/GammaCorrectionCommon.ush" // sRGBToLinear for the LinearOutput composite permutation; LinearToSrgb for engine textures
#include "/Plugin/VaCuus/Private/VaCuusUIInterpolants.ush"

/** Pixel-space -> clip-space, UE row-vector convention (v' = v * M). */
float4x4 Projection;

FVaCuusUIInterpolants MainVS(
	in float2 InPosition : ATTRIBUTE0,
	in float4 InColor : ATTRIBUTE1,
	in float2 InUV : ATTRIBUTE2)
{
	FVaCuusUIInterpolants Out;
	Out.Position = mul(float4(InPosition, 0.0f, 1.0f), Projection);
	Out.UV = InUV;
	Out.Color = InColor; // premultiplied RGBA (VET_UByte4N, memory order)
	return Out;
}

Texture2D UITexture;
SamplerState UISampler;
uint bUseTexture;

/**
 * ENGINE-TEXTURE READ MODES (spec 2026-08-22 §4). Both are 0 for every VaCuus-owned
 * texture, so the branches below are uniform and fold away on the ordinary path.
 *
 * WHY THE ORDER IS UN-PREMULTIPLY -> ENCODE -> RE-PREMULTIPLY, and not encode in place:
 * the sRGB transfer curve applies to the STRAIGHT colour, and LinearToSrgb(a*c) is not
 * a*LinearToSrgb(c) for a < 1. This is the same argument, in the same direction, that
 * MainCompositePS below makes for its decode -- and it is why the two modes cannot be
 * collapsed into one multiply.
 */
uint TextureEncoding;  // 0 = Raw, 1 = EncodeFromLinear
uint TextureAlphaMode; // 0 = Premultiplied, 1 = Opaque, 2 = Straight

void MainPS(
	FVaCuusUIInterpolants In,
	out float4 OutColor : SV_Target0)
{
	float4 Tex = bUseTexture ? UITexture.Sample(UISampler, In.UV) : float4(1.0f, 1.0f, 1.0f, 1.0f);

	if (bUseTexture && (TextureEncoding != 0 || TextureAlphaMode != 0))
	{
		// Straight colour and coverage, whatever the source convention was.
		float Alpha = (TextureAlphaMode == 1) ? 1.0f : Tex.a;
		// max() guards the a=0 un-premultiply; premultiplied content has rgb <= a, so the
		// result stays in [0,1] (MainCompositePS makes the same guard for the same reason).
		float3 Straight = (TextureAlphaMode == 0) ? (Tex.rgb / max(Tex.a, 1e-6f)) : Tex.rgb;

		if (TextureEncoding != 0)
		{
			// The pipeline stores sRGB-ENCODED premultiplied pixels in the view RT and
			// decodes at composite time; a sampler that already decoded (an _SRGB format)
			// or a float format carrying linear content would otherwise read ~2.2-gamma
			// too dark once the composite decodes a second time.
			Straight = LinearToSrgb(Straight);
		}

		Tex = float4(Straight * Alpha, Alpha);
	}

	OutColor = In.Color * Tex; // premultiplied * premultiplied
}

Texture2D CompositeTexture;
SamplerState CompositeSampler;

/**
 * Slate composite: paired with the engine's FScreenPassVS (which outputs
 * noperspective float4 UVAndScreenPos, .xy = input-viewport UV). Passes the
 * premultiplied UI RT through untouched; the premultiplied-over blend state
 * on the pipeline does the actual compositing.
 *
 * VACUUS_LINEAR_OUTPUT (M6, spec §3.2 — the PF_FloatRGBA editor/PIE permutation):
 * the UI RT holds sRGB-encoded premultiplied pixels (the M1 contract), and a float
 * elements texture holds LINEAR pixels (the engine pins DisplayGamma to 1.0 for a
 * FloatRGBA backbuffer, UnrealEngine.cpp:2501-2504, so Slate's own batches skip
 * their LinearToSrgb — SlateElementPixelShader.usf:87-99). Decode order matters:
 * the transfer curve was applied to the STRAIGHT color before premultiplication
 * (sRGBToLinear(a*c) != a*sRGBToLinear(c) for a<1), so un-premultiply, decode with
 * sRGBToLinear (the exact inverse of the LinearToSrgb encode Slate would have
 * applied, GammaCorrectionCommon.ush:45-60), re-premultiply. Alpha is coverage,
 * not color: it carries no transfer curve either way. The One/InvSrcAlpha blend
 * stays correct — blending premultiplied linear over linear.
 */
void MainCompositePS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	out float4 OutColor : SV_Target0)
{
	float4 UI = CompositeTexture.Sample(CompositeSampler, UVAndScreenPos.xy);
#if VACUUS_LINEAR_OUTPUT
	// max() guards the a=0 un-premultiply; premultiplied content has rgb <= a
	// (bilinear interpolation preserves the bound), so Straight stays in [0,1].
	float3 Straight = UI.rgb / max(UI.a, 1e-6f);
	UI.rgb = sRGBToLinear(Straight) * UI.a;
#endif
	OutColor = UI;
}
