/* __APP_NAME__ styles. vacuus-base.rcss supplies the UA layer (display
   defaults, body sizing, the registered font); put app styles here. */
#app-root {
	margin: 24dp;
}

.bump {
	display: inline-block;
	padding: 8dp 16dp;
	background-color: #2a2a40;
	border-radius: 4dp;
}

.bump:hover {
	background-color: #3a3a58;
}
