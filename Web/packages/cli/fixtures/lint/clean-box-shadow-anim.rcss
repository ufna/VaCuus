/* Clean fixture for the box-shadow-animation rule: box-shadow is static; the
   transition and keyframes animate opacity/transform, which RmlUi supports.
   Web/smoke.mjs asserts this file stays SILENT. */
.card {
	box-shadow: #00000080 2px 2px 6px 0px;
	transition: opacity 0.3s ease-in-out;
}

@keyframes pulse {
	from { opacity: 0; transform: scale(0.9); }
	to { opacity: 1; transform: scale(1.0); }
}
