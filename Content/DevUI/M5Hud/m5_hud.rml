<rml>
<head>
	<title>VaCuus M5 TSX HUD</title>
	<!-- Base sheet FIRST — the missing UA layer (div is inline without it,
	     vacuus-base.rcss carries the §13 list) — then the app sheet. -->
	<link type="text/rcss" href="vacuus-base.rcss"/>
	<link type="text/rcss" href="m5_hud.rcss"/>
	<!-- The committed bundle `vacuus build --app Web/apps/demo-hud` emits, WITH
	     RECORDED PROVENANCE beside it (hud_bundle.provenance.json): the in-engine
	     test VaCuus.Js.Preact.BundleMount asserts the provenance still matches the
	     current facade manifest and skips-with-a-named-warning on mismatch (spec
	     §2(l) — a facade change gives a rebuild instruction, not a red).
	     Captured at load, executed at OnDocumentReady; src resolves through the
	     ordered DevUI roots. -->
	<script src="M5Hud/hud_bundle.js"></script>
</head>
<body>
	<!-- The dedicated EMPTY mount element (E-P1): mounting into body is
	     impossible on this facade, and pre-existing children would be ADOPTED by
	     preact's excess-children scan, not preserved. -->
	<div id="mount"/>
</body>
</rml>
