/* The M5 TSX HUD's own sheet — vacuus-base.rcss supplies the UA layer. */
#hud-root {
	margin: 24dp;
	width: 420dp;
}

#hud-title {
	font-size: 22dp;
	color: #9fd8ff;
	margin-bottom: 12dp;
}

.panel {
	display: block;
	background-color: #10101acc;
	border-width: 1dp;
	border-color: #2a2a40;
	padding: 10dp;
	margin-bottom: 10dp;
}

.row {
	display: block;
	margin-bottom: 6dp;
}

.key {
	color: #8a8aa8;
}

.val {
	color: #ffffff;
	margin-left: 8dp;
}

#health-bar {
	display: block;
	width: 100%;
	height: 10dp;
	background-color: #22222f;
}

#health-bar-fill {
	display: block;
	height: 100%;
	background-color: #4fc36f;
}

#sim-btn {
	display: inline-block;
	margin-left: 12dp;
	padding: 2dp 10dp;
	background-color: #2a2a40;
}

#sim-btn:hover {
	background-color: #3a3a58;
}

.kill-row {
	display: block;
	color: #d8d8e8;
	margin-bottom: 2dp;
}
